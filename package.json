{
  "name": "no-fight-app",
  "version": "3.0.0",
  "private": true,
  "description": "Огонёк — Telegram Mini App для пар: счётчик дней без ссор. Cloudflare Worker + D1 + static assets.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create no-fight-db",
    "db:migrate:local": "wrangler d1 migrations apply no-fight-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply no-fight-db --remote",
    "secret:bot-token": "wrangler secret put BOT_TOKEN"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
